# ---------------------------------------------------------------------------
# Vela — client environment
#
# ONLY non-secret, publishable values belong here. Anything in an EXPO_PUBLIC_*
# variable is embedded in the app bundle and readable by anyone who downloads
# it. AI provider keys, the Stripe secret key, and the Supabase service role key
# are set as Edge Function secrets instead — never here.
# ---------------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Where Stripe checkout returns after payment.
EXPO_PUBLIC_WEB_BASE_URL=https://vela.app
